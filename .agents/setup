#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Setting up sids.in for Amp..."

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js 22.13.0 or newer is required."
  exit 1
fi

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 13) ? 0 : 1)'; then
  echo "Node.js 22.13.0 or newer is required (found $(node --version))."
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Installing pnpm..."
  npm install --global "$(node -p 'require("./package.json").packageManager')"
fi

echo "Installing dependencies from pnpm-lock.yaml..."
pnpm install --frozen-lockfile

echo "Generating the content manifest and compiled assets..."
pnpm run build

echo "Orb setup complete."
