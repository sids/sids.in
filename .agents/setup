#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Setting up sids.in for Amp..."

mise_bin="$HOME/.local/bin/mise"
if [[ ! -x "$mise_bin" ]]; then
  echo "Installing mise..."
  curl -fsSL https://mise.run | sh
fi

export PATH="$HOME/.local/bin:$PATH"
"$mise_bin" trust --yes "$repo_root/.mise.toml"
"$mise_bin" install

# Orb shells and supervised services already include ~/.local/bin in PATH.
# Link the pinned tools there so they remain selected after this script exits.
for tool in node npm npx corepack pnpm; do
  ln -sfn "$("$mise_bin" which "$tool")" "$HOME/.local/bin/$tool"
done

echo "Using Node $(node --version) and pnpm $(pnpm --version)."

echo "Installing dependencies from pnpm-lock.yaml..."
pnpm install --frozen-lockfile

echo "Generating the content manifest and compiled assets..."
pnpm run build

echo "Orb setup complete."
