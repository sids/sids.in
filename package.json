{
  "name": "sids.in",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --minify",
    "build:manifest": "tsx scripts/build-manifest.ts",
    "build": "pnpm run build:css && pnpm run build:manifest",
    "dev:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --watch",
    "dev:worker": "pnpm run build:manifest && wrangler dev --ip 0.0.0.0",
    "dev": "concurrently \"pnpm run dev:css\" \"pnpm run dev:worker\"",
    "deploy": "pnpm run build && wrangler deploy",
    "types": "wrangler types",
    "sync:bear": "tsx scripts/sync-bear-posts.ts",
    "sync:bear:dry-run": "tsx scripts/sync-bear-posts.ts --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.13.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.54.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.1",
    "front-matter": "^4.0.2",
    "marked": "^17.0.1",
    "marked-footnote": "^1.4.0",
    "zod": "^4.4.3"
  }
}
